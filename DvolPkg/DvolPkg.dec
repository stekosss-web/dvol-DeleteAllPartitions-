  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = DvolPkg
  PACKAGE_GUID                   = A1B2C3D4-E5F6-7890-ABCD-EF1234567890
  PACKAGE_VERSION                = 1.0

[Includes]
  Include

[Guids]
  gDvolPkgTokenSpaceGuid = { 0xA1B2C3D4, 0xE5F6, 0x7890, { 0xAB, 0xCD, 0xEF, 0x12, 0x34, 0x56, 0x78, 0x90 }}
  gDvolShellHiiGuid     = { 0x9E5E4E20, 0xA3C9, 0x4E17, { 0x8A, 0x35, 0x5F, 0x11, 0x62, 0xA1, 0xB7, 0x4C }}
