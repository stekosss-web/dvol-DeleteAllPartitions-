## @file
# dvol - Standalone UEFI Application for wiping MBR/GPT partitions.
#
# A two-phase UEFI application that:
#   Phase 1: Scans all disks, displays info about partitions (MBR/GPT).
#   Phase 2: Asks confirmation, then wipes partition tables.
#
# CLI Options:
#   -y, --yes              Skip confirmation prompt
#   -n, --dry-run          Scan only, do NOT write to disk
#   -r, --removable        Include removable media (USB, SD, etc.)
#   -d <N>, --disk <N>     Target specific disk by scan index
#   -o <PATH>, --output <PATH>  Export log to FAT file (e.g., fs0:\log.txt)
#   -h, --help             Show help
#
# Copyright (c) 2026. All rights reserved.
# SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = dvol
  FILE_GUID                      = E1F2A3B4-C5D6-7E8F-9A0B-1C2D3E4F5A6B
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UefiMain
  UEFI_HII_RESOURCE_SECTION      = TRUE

[Sources]
  DvolApp.c

[Packages]
  MdePkg/MdePkg.dec
  ShellPkg/ShellPkg.dec
  DvolPkg/DvolPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiLib
  UefiBootServicesTableLib
  MemoryAllocationLib
  BaseLib
  BaseMemoryLib
  DebugLib
  PrintLib
  DevicePathLib
  FileHandleLib
  SafeIntLib

[Protocols]
  gEfiBlockIoProtocolGuid           ## CONSUMES
  gEfiDiskIoProtocolGuid            ## CONSUMES
  gEfiDevicePathProtocolGuid        ## CONSUMES
  gEfiDevicePathToTextProtocolGuid  ## CONSUMES
  gEfiSimpleFileSystemProtocolGuid  ## CONSUMES
  gEfiShellProtocolGuid             ## CONSUMES
  gEfiShellParametersProtocolGuid   ## CONSUMES
  gEfiDiskInfoProtocolGuid          ## CONSUMES

[Guids]
  gEfiDiskInfoIdeInterfaceGuid      ## CONSUMES
  gEfiDiskInfoAhciInterfaceGuid     ## CONSUMES
  gEfiDiskInfoNvmeInterfaceGuid     ## CONSUMES
  gEfiDiskInfoScsiInterfaceGuid     ## CONSUMES
  gEfiDiskInfoUsbInterfaceGuid      ## CONSUMES
  gEfiFileInfoGuid                  ## CONSUMES
  gDvolPkgTokenSpaceGuid            ## CONSUMES
